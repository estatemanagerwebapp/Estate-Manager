{
  "name": "@silverstone/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Silverstone Managers web console (React + Vite + TypeScript + Tailwind).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@silverstone/shared": "0.1.0",
    "lucide-react": "^0.545.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
