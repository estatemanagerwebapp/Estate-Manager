{
  "$comment": "Bootstrap defaults for a Silverstone Managers deployment. This file is read once, when an organization is provisioned. After provisioning, the database copy is authoritative and changes here do not affect a live organization.",
  "schemaVersion": "1.0.0",
  "organization": {
    "name": "Silverstone Managers",
    "slug": "silverstone",
    "timezone": "Africa/Lagos",
    "locale": "en-NG",
    "currency": "NGN"
  },
  "branding": {
    "primaryColor": "#FF5A1F",
    "portalName": "Silverstone Resident Portal"
  },
  "assetModel": {
    "types": [
      {
        "key": "land",
        "label": "Land",
        "detailKind": "LAND_PARCEL",
        "requiresUnits": false,
        "unitTypeKeys": [],
        "active": true
      },
      {
        "key": "house",
        "label": "House",
        "detailKind": "PROPERTY",
        "requiresUnits": false,
        "unitTypeKeys": [],
        "active": true
      }
    ],
    "unitTypes": [],
    "allowMultipleAssetsPerResident": true,
    "requireApprovalForAssignmentChanges": true
  },
  "propertyOptions": {
    "addressComponents": [
      {
        "key": "street_name",
        "label": "Street name",
        "requiredFor": ["land", "house"],
        "notApplicableFor": [],
        "maxLength": 120,
        "pattern": null
      },
      {
        "key": "plot_number",
        "label": "Plot number",
        "requiredFor": ["land"],
        "notApplicableFor": [
          "house.bungalow",
          "house.terrace",
          "house.duplex",
          "house.apartment",
          "house.flat"
        ],
        "maxLength": 32,
        "pattern": "\\d+"
      },
      {
        "key": "house_number",
        "label": "House number",
        "requiredFor": ["house.bungalow", "house.terrace", "house.duplex"],
        "notApplicableFor": ["house.apartment", "house.flat", "land"],
        "maxLength": 32,
        "pattern": "\\d+[A-Za-z]?"
      },
      {
        "key": "block_name",
        "label": "Building / block name",
        "requiredFor": ["house.apartment", "house.flat"],
        "notApplicableFor": ["house.bungalow", "house.terrace", "house.duplex", "land"],
        "maxLength": 64,
        "pattern": null
      },
      {
        "key": "floor_number",
        "label": "Floor number",
        "requiredFor": ["house.apartment", "house.flat"],
        "notApplicableFor": ["house.bungalow", "house.terrace", "house.duplex", "land"],
        "maxLength": 16,
        "pattern": "\\d+"
      },
      {
        "key": "unit_number",
        "label": "Unit / apartment number",
        "requiredFor": ["house.apartment", "house.flat"],
        "notApplicableFor": ["house.bungalow", "house.terrace", "house.duplex", "land"],
        "maxLength": 32,
        "pattern": "\\d+[A-Za-z]?"
      }
    ],
    "houseTypes": [
      { "key": "bungalow", "label": "Bungalow", "active": true },
      { "key": "terrace", "label": "Terrace", "active": true },
      { "key": "duplex", "label": "Duplex", "active": true },
      { "key": "apartment", "label": "Apartment", "active": true },
      { "key": "flat", "label": "Flat", "active": true }
    ],
    "identifierTemplate": "{estate_slug}",
    "identifierMax": 120,
    "$comment": "Address structure is configurable per deployment. House sub-types are configured via houseTypes; each address component declares which top-level type and/or house sub-type it applies to via requiredFor / notApplicableFor. Identifier formulas are code-defaulted per type and not editable here."
  },
  "modules": {
    "estates": true,
    "residents": true,
    "properties": true,
    "assignments": true,
    "billing": true,
    "payments": true,
    "gateAccess": true,
    "maintenance": true,
    "power": false,
    "pettyCash": false,
    "facilities": false,
    "shortlet": false
  },
  "fees": {
    "registration": {
      "amountKobo": 5000000,
      "currency": "NGN",
      "cadence": "ONE_OFF",
      "refundable": false,
      "description": "One-off resident registration fee"
    }
  },
  "onboarding": {
    "invitationCode": {
      "length": 10,
      "ttlMinutes": 1440,
      "maxAttempts": 5,
      "singleUse": true
    },
    "requireEmail": true,
    "requireGovernmentId": true,
    "requireNextOfKin": true,
    "dependantsEnabled": true,
    "maxDependants": 5,
    "createAccountOnlyAfterVerifiedPayment": true
  },
  "accessCodes": {
    "defaultDurationHours": 720
  },
  "payments": {
    "provider": "NONE",
    "environment": "TEST",
    "serverControlledAmounts": true,
    "bankTransfer": {
      "bankName": null,
      "accountName": null,
      "accountNumber": null,
      "sortCode": null,
      "instructions": null
    }
  },
  "sos": {
    "contacts": []
  },
  "roles": {
    "grants": []
  },
  "customFields": []
}
