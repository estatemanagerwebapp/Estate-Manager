{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "dist/vercel.js",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run prisma:generate && npm run build:packages && npm run build:api && cp config/organization.default.json apps/api/dist/modules/organization/organization.default.json",
      "functions": {
        "dist/vercel.js": {
          "includeFiles": "dist/modules/organization/organization.default.json"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build:web",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
