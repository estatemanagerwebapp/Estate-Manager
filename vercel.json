{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "cd ../.. && npm run prisma:generate && npm run build:packages && cp config/organization.default.json apps/api/organization.default.json && npm run build:api",
      "functions": {
        "src/server.ts": {
          "includeFiles": "{organization.default.json,package.json}",
          "regions": ["fra1"]
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build:web",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
