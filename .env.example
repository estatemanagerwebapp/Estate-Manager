# =============================================================================
# Silverstone Managers — environment template
# Copy to `.env` and fill in locally.  NEVER commit the real `.env`.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_NAME=Silverstone Managers
PORT=4000

# --- API ---------------------------------------------------------------------
# Public base path for the versioned API. Change only with a version bump.
API_BASE_PATH=/api/v1

# Comma-separated allowlist. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:5173

# Request body ceiling accepted by the API (express-style size string).
BODY_LIMIT=1mb

# Number of reverse proxies in front of the API (0 = none).
TRUST_PROXY=0

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Database ----------------------------------------------------------------
# PostgreSQL connection used by Prisma.
# Supabase pooler example (transaction mode):
#   postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Local example:
#   postgresql://silverstone:silverstone@localhost:5432/silverstone
DATABASE_URL=postgresql://silverstone:silverstone@localhost:5432/silverstone

# Optional direct (non-pooled) connection used for migrations when the
# runtime URL points at a pooler.
# DIRECT_URL=postgresql://silverstone:silverstone@localhost:5432/silverstone

# --- Organization ------------------------------------------------------------
# Deployment identity. One organization per deployment (single-tenant).
ORGANIZATION_SLUG=silverstone

# --- Graceful shutdown -------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=10000

# --- Authentication (Phase 1) -------------------------------------------------
# Session cookie lifetime, in days (1-30).
SESSION_LIFETIME_DAYS=7

# Web console base URL. Used to build absolute password-reset links in email.
WEB_BASE_URL=http://localhost:5173

# Password reset token lifetime, in minutes (5-1440).
RESET_TOKEN_TTL_MINUTES=60

# --- Email delivery (Phase 1) -------------------------------------------------
# Which adapter the API uses to send password-reset emails:
#   console — log the message locally, no real delivery (dev default)
#   resend  — post to the Resend HTTP API (production)
#   mock    — record messages in memory; tests only
EMAIL_PROVIDER=console

# Resend API key. Required only when EMAIL_PROVIDER=resend.
#RESEND_API_KEY=

# Sender address for outbound email.
EMAIL_FROM=Silverstone Managers <noreply@silverstone.local>

# NOTE: operator/administrator credentials for the initial bootstrap
# (`npm run bootstrap:admin`) are never stored here. Use ADMIN_EMAIL /
# ADMIN_PASSWORD as transient shell variables, e.g.:
#   ADMIN_EMAIL=ops@example.com ADMIN_PASSWORD=$(openssl rand -base64 18) \
#     npm run bootstrap:admin
