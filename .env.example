# ==========================================
# ESTATE MANAGER - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=/api

# Database Configuration (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Authentication & Security (generate with: openssl rand -base64 32)
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=super-secret-refresh-token-key-replace-in-production
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-signing-key

# Rate Limiting & Webhooks
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ONBOARDING_WEBHOOK_SECRET=onboarding-ingestion-secret-key-32chars
