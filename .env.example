# ==========================================
# ESTATE MANAGER - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000

# Client Configuration
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api

# Database Configuration (MongoDB)
# Local: mongodb://localhost:27017/estate_manager
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/estate_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/estate_manager
MONGODB_DEBUG=false

# Authentication & Security
# Generate secure keys via: openssl rand -base64 32
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=super-secret-refresh-token-key-replace-in-production
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-signing-key

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Gate Security Configuration
GATE_VERIFICATION_TIMEOUT_MS=5000
MAX_OFFLINE_QUEUE_ITEMS=500

# Storage / Media Uploads (Local or S3/Cloudinary)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# External Integrations (Webhook secret for external onboarding ingestion)
ONBOARDING_WEBHOOK_SECRET=onboarding-ingestion-secret-key-32chars
PAYMENT_GATEWAY_KEY=pk_test_payment_gateway_mock_key
PAYMENT_WEBHOOK_SECRET=whsec_payment_webhook_secret
