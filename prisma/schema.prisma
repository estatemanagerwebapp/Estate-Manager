// Silverstone Managers — Phase 0 foundation + Phase 1 identity.
//
// Phase 0 ships the organization identity and a versioned configuration
// document that becomes the source of truth once provisioned. Phase 1 adds
// the identity surface: staff users, http-only session cookies, hashed
// password-reset tokens and an append-only security audit log.
//
// The wider estate domain (estates, residents, assets, assignments, invoices,
// payments, invitations) arrives in later phases with its own reviewed
// migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConfigStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// One organization per deployment. No tenant column: the deployment *is* the
/// organization.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  slug      String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  configs             OrganizationConfig[]
  users               User[]
  estates             Estate[]
  residentOnboardings ResidentOnboarding[]
  mediaFiles          MediaFile[]
  invoices            Invoice[]
  payments            Payment[]
  transactions        Transaction[]
  accessCodes         AccessCode[]
  complaints          Complaint[]
  messageThreads      MessageThread[]
  announcements       Announcement[]
  estateBroadcasts    EstateBroadcast[]
  facilities          Facility[]
  bookings            Booking[]
  sosEvents           SosEvent[]
  notifications       Notification[]

  @@map("organizations")
}

/// Immutable, versioned configuration documents. A deployment may hold many
/// versions; exactly one may be ACTIVE (enforced by a partial unique index in
/// the initial migration, which Prisma cannot express declaratively).
model OrganizationConfig {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  version        Int
  status         ConfigStatus @default(DRAFT)
  schemaVersion  String       @map("schema_version") @db.VarChar(20)
  /// Validated organization configuration document (see @silverstone/config-schema).
  payload        Json
  createdBy      String?      @map("created_by") @db.VarChar(160)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt    DateTime?    @map("activated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@map("organization_configs")
}

// ---------------------------------------------------------------------------
// Phase 1 — Identity, authentication, RBAC and audit.
// ---------------------------------------------------------------------------

/// Staff identities. This is *not* the Resident model: resident accounts
/// arrive with the resident domain in a later phase and are separated from
/// staff users by design. Role and status values mirror `ROLE_KEYS` /
/// `ACCOUNT_STATUSES` from `@silverstone/shared`; they are plain strings so
/// the database can evolve independently of the Prisma enum.
model User {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  /// Normalized lowercase email; enforced unique per deployment.
  email                 String    @db.VarChar(255)
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  fullName              String?   @map("full_name") @db.VarChar(160)
  phone                 String?   @db.VarChar(40)
  role                  String    @db.VarChar(20)
  status                String    @default("ACTIVE") @db.VarChar(20)
  lastPasswordChangedAt DateTime? @map("last_password_changed_at") @db.Timestamptz(6)
  /// True while the credential is the generated post-payment demo password;
  /// first login must change it (enforced in the web shell).
  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  auditEvents        AuditEvent[]
  mediaFiles         MediaFile[]
  residentOnboarding ResidentOnboarding?
  invoices           Invoice[]
  payments           Payment[]
  transactions       Transaction[]
  accessCodes        AccessCode[]
  complaints         Complaint[]
  complaintReplies   ComplaintReply[]
  messageThreads     MessageThread[]
  announcements      Announcement[]
  bookings           Booking[]
  sosEvents          SosEvent[]
  notifications      Notification[]

  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@map("users")
}

/// Resident onboarding draft: created by an admin (first name + property
/// assignment, email/phone optional) and completed by the resident
/// out-of-band. The access code is persistent — no TTL, no attempt cap,
/// not single-use — so a resident can return and resume at any time.
/// Only the SHA-256 hash of the code is stored; the plaintext is returned
/// to the admin (who may re-share it) and reused by the resident.
///
/// The actual `User` row is created only after verified payment
/// (`paymentStatus = PAID` + all resident fields + ID document), linking
/// via `userId`.
model ResidentOnboarding {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// The assigned property/estate location.
  propertyId     String @map("property_id") @db.Uuid

  /// PENDING (in progress) or COMPLETED (User account created).
  status         String  @default("PENDING") @db.VarChar(20)
  /// SHA-256 hex of the persistent access code.
  codeHash       String  @unique @map("code_hash") @db.VarChar(64)
  /// Plaintext onboarding code, stored so the admin can re-share it on the
  /// Residents screen at any time. Null for rows created before this field
  /// was added.
  onboardingCode String? @map("onboarding_code") @db.VarChar(32)

  // --- Admin-provided (prefilled; read-only to the resident) ---------------
  firstName String  @map("first_name") @db.VarChar(120)
  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(40)

  // --- Resident-provided (autosaved as the resident works) ------------------
  gender         String? @db.VarChar(16)
  maritalStatus  String? @map("marital_status") @db.VarChar(16)
  /// Unit type key within the assigned property, when the property supports
  /// units. Null for top-level (house/plot) assignments.
  propertyType   String? @map("property_type") @db.VarChar(48)
  nextOfKinName  String? @map("next_of_kin_name") @db.VarChar(160)
  nextOfKinPhone String? @map("next_of_kin_phone") @db.VarChar(40)
  nextOfKinEmail String? @map("next_of_kin_email") @db.VarChar(255)
  idType         String? @map("id_type") @db.VarChar(32)
  /// Public URL of the uploaded ID document (MediaFile).
  idDocumentUrl  String? @map("id_document_url") @db.VarChar(2048)

  // --- Payment --------------------------------------------------------------
  /// UNPAID or PAID. Set to PAID by the admin (provider NONE) or a
  /// provider webhook; completion requires PAID.
  paymentStatus String    @default("UNPAID") @map("payment_status") @db.VarChar(16)
  paymentRef    String?   @map("payment_ref") @db.VarChar(120)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)

  /// Set when the account is created after payment.
  userId      String?   @unique @map("user_id") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// Soft archive. Archived records remain in the register for history but
  /// are hidden from the active list and their onboarding code no longer
  /// resolves. Portal access is controlled separately.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  estate       Estate?      @relation(fields: [estateId], references: [id])
  estateId     String?      @db.Uuid

  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([propertyId])
  @@map("resident_onboardings")
}

/// A media file stored on the local volume (cloud storage — R2 — will be
/// plugged in via the same model when the deployment moves to Vercel).
/// `relativePath` is relative to the configured uploads root; the public
/// URL is `baseUrl + relativePath`.
model MediaFile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  relativePath   String   @unique @map("relative_path") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(120)
  sizeBytes      Int      @map("size_bytes")
  originalName   String?  @map("original_name") @db.VarChar(255)
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("media_files")
}

// --- Phase 3 — resident finance (S3) ------------------------------------------
// Additive models for the resident billing domain. No changes to existing
// tables. The registration fee seeds the first invoice + payment +
// transaction when the resident account is created (config-driven amount).

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  propertyId     String?  @map("property_id") @db.Uuid
  /// Billing period label, e.g. "Registration fee" or "2026-11".
  period         String   @db.VarChar(48)
  amountKobo     Int      @map("amount_kobo")
  currency       String   @default("NGN") @db.VarChar(8)
  /// UNPAID | PAID | OVERDUE | VOID.
  status         String   @default("UNPAID") @db.VarChar(16)
  dueAt          DateTime @map("due_at") @db.Timestamptz(6)
  issuedAt       DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([organizationId, userId, status])
  @@map("invoices")
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  amountKobo     Int      @map("amount_kobo")
  method         String   @db.VarChar(32)
  reference      String?  @db.VarChar(120)
  paidAt         DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invoiceId])
  @@map("payments")
}

model Transaction {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// INVOICE | PAYMENT | REFUND | FEE.
  kind           String   @db.VarChar(16)
  amountKobo     Int      @map("amount_kobo")
  /// Signed amount: positive = credit (incoming), negative = debit (outgoing).
  signed         Int
  memo           String?  @db.VarChar(255)
  reference      String?  @db.VarChar(120)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, occurredAt(sort: Desc)])
  @@map("transactions")
}

// --- Phase 3 — resident access codes (S4) -------------------------------------
// Additive model for gate-access codes. The full code is returned exactly
// once at generation; only its SHA-256 hash and a short display prefix are
// stored, so a database leak never yields a usable code.

model AccessCode {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  propertyId     String?   @map("property_id") @db.Uuid
  /// ENTRY | EXIT | BOTH.
  kind           String    @db.VarChar(16)
  /// SHA-256 hex of the full code. The plaintext is never stored.
  codeHash       String    @map("code_hash") @db.VarChar(64)
  /// First characters of the code, for display only.
  codePrefix     String    @map("code_prefix") @db.VarChar(8)
  /// ACTIVE | REVOKED | EXPIRED.
  status         String    @default("ACTIVE") @db.VarChar(16)
  /// End of the validity window; null = no expiry (open-ended code).
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(6)
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, status])
  @@map("access_codes")
}

// --- Phase 3 — resident complaints (S5) ----------------------------------------
// Additive models: a complaint filed by a resident on their property, plus
// the reply thread written by the estate office.

model Complaint {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  propertyId     String?   @map("property_id") @db.Uuid
  category       String    @db.VarChar(48)
  subject        String    @db.VarChar(160)
  description    String
  /// OPEN | IN_PROGRESS | RESOLVED | CLOSED.
  status         String    @default("OPEN") @db.VarChar(16)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  replies      ComplaintReply[]

  @@index([organizationId, userId, status])
  @@map("complaints")
}

model ComplaintReply {
  id          String   @id @default(uuid()) @db.Uuid
  complaintId String   @map("complaint_id") @db.Uuid
  /// The estate-office user who replied; null when the author was removed.
  authorId    String?  @map("author_id") @db.Uuid
  body        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@map("complaint_replies")
}

// --- Phase 3 — resident messages (S6) ---------------------------------------------
// Additive models: a conversation thread started by a resident, and the
// messages posted into it by either side.

model MessageThread {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// The resident who started the thread; also its owner for scoping.
  residentUserId String   @map("resident_user_id") @db.Uuid
  subject        String   @db.VarChar(160)
  /// OPEN | CLOSED.
  status         String   @default("OPEN") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resident     User         @relation(fields: [residentUserId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId, residentUserId])
  @@map("message_threads")
}

model Message {
  id         String   @id @default(uuid()) @db.Uuid
  threadId   String   @map("thread_id") @db.Uuid
  /// RESIDENT | ESTATE_OFFICE.
  senderRole String   @map("sender_role") @db.VarChar(16)
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("messages")
}

// --- Phase 3 — resident community feed (S7) ----------------------------------------
// Read-only feeds for residents. Announcements are organization-wide;
// broadcasts are estate-scoped and carry a priority plus an optional expiry.
// Both are written by the estate office, never by a resident.

model Announcement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String   @db.VarChar(160)
  body           String
  /// The estate-office user who published it; null when the author was removed.
  authorId       String?  @map("author_id") @db.Uuid
  publishedAt    DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, publishedAt])
  @@map("announcements")
}

model EstateBroadcast {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  estateId       String    @map("estate_id") @db.Uuid
  title          String    @db.VarChar(160)
  body           String
  /// INFO | WARNING | CRITICAL.
  priority       String    @default("INFO") @db.VarChar(16)
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// Null = no expiry.
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  estate       Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([organizationId, estateId, issuedAt])
  @@map("estate_broadcasts")
}

// --- Phase 3 — facilities & bookings (S8) -----------------------------------------
// Facilities are listed per estate (or organization-wide when estateId is
// null) and may be bookable. Bookings are owned by the resident who made
// them and carry a window plus a status.

model Facility {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Null = available to every estate in the organization.
  estateId       String?  @map("estate_id") @db.Uuid
  name           String   @db.VarChar(160)
  description    String
  bookable       Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  estate       Estate?      @relation(fields: [estateId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([organizationId, estateId])
  @@map("facilities")
}

model Booking {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  facilityId     String   @map("facility_id") @db.Uuid
  startsAt       DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(6)
  attendees      Int?
  /// REQUESTED | CONFIRMED | CANCELLED | COMPLETED.
  status         String   @default("REQUESTED") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility     Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, startsAt])
  @@index([facilityId, startsAt, endsAt])
  @@map("bookings")
}

// --- Phase 3 — resident emergency / SOS (S9) ----------------------------------------
// An SOS event is raised by a resident against their assigned property and
// is worked by the estate office. The timestamps of each stage are kept on
// the row so the history reads clearly.

model SosEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Null when the resident has no assigned property yet.
  propertyId     String?   @map("property_id") @db.Uuid
  note           String?   @db.VarChar(500)
  /// RAISED | ACKNOWLEDGED | RESOLVED.
  status         String    @default("RAISED") @db.VarChar(16)
  raisedAt       DateTime  @default(now()) @map("raised_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, raisedAt])
  @@index([organizationId, status])
  @@map("sos_events")
}

// --- Phase 3 — resident notifications (S10) -----------------------------------------
// A per-resident inbox. The estate office and the resident's own actions
// (a booking request, for instance) enqueue entries; the resident reads
// and dismisses them.

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// BOOKING | ANNOUNCEMENT | BROADCAST | COMPLANT | SYSTEM.
  kind           String   @db.VarChar(16)
  title          String   @db.VarChar(160)
  body           String
  read           Boolean  @default(false) @map("is_read")
  /// An in-app route the resident can follow, e.g. "/resident/app/bookings".
  linkTo         String?  @map("link_to") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
  @@index([organizationId, userId, read])
  @@map("notifications")
}

/// HttpOnly-cookie session. The cookie carries an opaque session id; the row
/// holds the expiration and revocation state. A null `expiresAt` marks a
/// revoked session (logout / password change / account suspension).
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Null means the session has been revoked.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Hashed password-reset tokens: a cryptographically random secret is never
/// stored in plaintext; only its SHA-256 hash is kept, so a database leak
/// does not leak reusable reset credentials.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 hash of the random token.
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set when the token is consumed; single-use.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Append-only security audit log. Rows are never updated or deleted by
/// application code; the only writes are insert.
model AuditEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  /// The acting user; null for system-level actions (bootstrap, seed).
  actorId        String?           @map("actor_id") @db.Uuid
  eventType      AuditEventType
  /// Which entity was affected; null when the event has no target.
  targetType     String?           @map("target_type") @db.VarChar(40)
  targetId       String?           @map("target_id") @db.Uuid
  requestId      String?           @map("request_id") @db.VarChar(64)
  outcome        AuditEventOutcome
  /// Redacted, non-secret context. Never stores passwords, tokens, reset
  /// links or full request bodies.
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, eventType, createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Estate management, property registry and bulk import.
//
// The property registry is intentionally explicit: a property is a House, a
// Land parcel, or Both, and the shape of each kind lives in typed columns. It
// is NOT driven by a runtime JSON configuration. A property's `identifier` is
// a human-facing registration code derived at create time from the typed
// address fields; it is NOT a substitute for the stable UUID `id` used by
// relationships.
// ---------------------------------------------------------------------------

/// A managed community or development. The natural duplicate-detection key
/// is the organization-scoped slug.
model Estate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Lowercase slug; unique per organization. Used as `{estate_slug}` in
  /// identifier templates. Changing a slug does NOT rewrite existing property
  /// identifiers (they were derived at create time and are immutable).
  slug           String   @db.VarChar(64)
  name           String   @db.VarChar(160)
  /// Free-text location/description. Not part of the identifier.
  address        String?  @db.VarChar(500)
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties          Property[]
  importBatches       ImportBatch[]
  residentOnboardings ResidentOnboarding[]
  estateBroadcasts    EstateBroadcast[]
  facilities          Facility[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("estates")
}

/// The organization's house-type catalogue. This is a real domain table, not a
/// JSON settings block: each row supplies a stable key, a display label and the
/// address shape the type requires. `requiresUnitFields` distinguishes
/// apartment/flat (block + floor + unit) from bungalow/terrace/duplex (house
/// number). New organizations insert their own rows; the property module reads
/// this table directly.
model HouseType {
  key                String   @id @db.VarChar(48)
  label              String   @db.VarChar(80)
  requiresUnitFields Boolean  @default(false) @map("requires_unit_fields")
  active             Boolean  @default(true)
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  properties Property[]

  @@map("house_types")
}

enum PropertyKind {
  HOUSE
  LAND
  BOTH
}

/// A registered physical property: a house, a land parcel, or a mixed
/// house-on-land record. The kind is explicit and the address fields are typed
/// columns; there is no runtime JSON address shape. `identifier` is derived once
/// at create time and is immutable.
model Property {
  id             String       @id @default(uuid()) @db.Uuid
  estateId       String       @map("estate_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// Canonical registration identifier, derived at create time from the typed
  /// address fields. Immutable.
  identifier     String       @db.VarChar(200)
  /// House, land, or a mixed house-on-land record.
  kind           PropertyKind
  /// Required for HOUSE and BOTH; null for LAND. References the house-type
  /// catalogue row that defines the address shape.
  houseTypeKey   String?      @map("house_type_key") @db.VarChar(48)

  // --- Shared / house fields -------------------------------------------------
  /// Street name. Required for every property kind.
  streetName  String  @map("street_name") @db.VarChar(120)
  /// Used by bungalow / terrace / duplex (house types without unit fields).
  houseNumber String? @map("house_number") @db.VarChar(32)
  /// Used by apartment / flat (house types with unit fields).
  blockName   String? @map("block_name") @db.VarChar(64)
  floorNumber String? @map("floor_number") @db.VarChar(16)
  unitNumber  String? @map("unit_number") @db.VarChar(32)

  // --- Land fields -----------------------------------------------------------
  /// Plot number/identifier. Required for LAND and BOTH.
  plotNumber String? @map("plot_number") @db.VarChar(32)
  /// Human-facing plot name. Required for LAND and BOTH.
  plotName   String? @map("plot_name") @db.VarChar(64)

  /// Human-facing name the organization gives this property. Distinct from the
  /// derived `identifier`; null for legacy/import-created records.
  name      String?  @db.VarChar(120)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  estate              Estate               @relation(fields: [estateId], references: [id], onDelete: Cascade)
  houseType           HouseType?           @relation(fields: [houseTypeKey], references: [key], onDelete: Restrict)
  residentOnboardings ResidentOnboarding[]
  invoices            Invoice[]
  accessCodes         AccessCode[]
  complaints          Complaint[]
  sosEvents           SosEvent[]

  /// The canonical identifier is unique within its estate. This is the
  /// backstop for all identifier-collision handling: the application pre-checks
  /// and reports a friendly 409, and the database constraint guarantees no
  /// duplicate is ever written even under a race.
  @@unique([estateId, identifier])
  @@index([organizationId, status])
  @@index([estateId, kind])
  @@index([houseTypeKey])
  @@map("properties")
}

/// A bulk-import submission. One row per uploaded workbook.
///
/// Lifecycle: `PREVIEWED` (uploaded + validated, no property records written)
/// -> `COMMITTED` (explicit commit created the valid rows) or
/// `COMMIT_FAILED` (transaction aborted; re-validate then retry).
/// `FAILED` marks a batch whose parsing itself blew up mid-write.
///
/// The `fingerprint` (SHA-256 of the raw file bytes) is the idempotency key
/// within one estate: re-uploading the same file re-uses the open batch
/// instead of creating a duplicate, and a committed fingerprint is rejected
/// with the existing batch id. The same workbook can be uploaded to a second
/// estate without colliding with the first estate's batch.
model ImportBatch {
  id             String      @id @default(uuid()) @db.Uuid
  estateId       String      @map("estate_id") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  filename       String      @db.VarChar(255)
  /// SHA-256 hex of the uploaded file contents.
  fingerprint    String      @db.VarChar(64)
  status         String      @default("PREVIEWED") @db.VarChar(20)
  /// Provenance only. Property shape and identifier rules are code-owned, so
  /// the commit path does not block when the organization config version
  /// advances between preview and commit.
  configVersion  Int         @map("config_version")
  /// Aggregated counts, updated at parse and at commit.
  counts         Json        @default("{}") @map("counts")
  uploadedById   String      @map("uploaded_by_id") @db.Uuid
  uploadedAt     DateTime    @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  committedAt    DateTime?   @map("committed_at") @db.Timestamptz(6)
  rows           ImportRow[]

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@unique([estateId, fingerprint])
  @@index([estateId, status])
  @@map("import_batches")
}

/// One worksheet row's import result. Persisted so invalid rows stay visible
/// after valid rows are committed, and so a failed commit can be retried.
model ImportRow {
  id         String  @id @default(uuid()) @db.Uuid
  batchId    String  @map("batch_id") @db.Uuid
  /// 1-based physical row number in the first worksheet of the uploaded workbook.
  /// Row 1 is the required header. Data rows retain their original worksheet
  /// row numbers; fully blank rows are skipped without renumbering.
  rowNumber  Int     @map("row_number")
  status     String  @default("VALID") @db.VarChar(24)
  /// Structured error reasons (human-readable, redacted — never the full
  /// uploaded spreadsheet contents).
  errors     Json    @default("[]")
  /// Set when the row resulted in a created property (status CREATED).
  propertyId String? @map("property_id") @db.Uuid
  /// Redacted data snapshot of the row for review. Never full resident PII.
  data       Json    @default("{}") @map("row_data")

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("import_rows")
}

/// Outcome of an audited action. Values are `success` / `failure` to match
/// the `AuditEventDto` wire contract in `@silverstone/shared`; Prisma keeps
/// the stored value as-is (Postgres enums are case-sensitive).
enum AuditEventOutcome {
  success
  failure
}

enum AuditEventType {
  login_succeeded
  login_failed
  logout
  password_changed
  password_reset_requested
  password_reset_completed
  account_suspended
  account_reactivated
  account_disabled
  user_role_changed
  user_deleted
  admin_bootstrap
  // Phase 2 — estate / property / import audit events.
  estate_created
  estate_updated
  estate_status_changed
  estate_deleted
  property_created
  property_updated
  property_status_changed
  property_deleted
  import_previewed
  import_completed
  import_commit_failed
  property_options_updated
  user_registered
  user_onboarding_completed
  // Phase 2 — resident onboarding (persistent code, payment-gated).
  resident_registered
  resident_onboarding_completed
  resident_payment_recorded
  resident_payment_submitted
  resident_deleted
  // Phase 3 — resident dashboard.
  resident_profile_updated
  resident_invoice_created
  resident_code_generated
  resident_code_extended
  resident_code_deactivated
  resident_complaint_created
  resident_message_sent
  resident_booking_created
  resident_booking_cancelled
  resident_sos_raised
  // Operator console — Phase 0 catalogue (emitted by later phases).
  resident_updated
  resident_archived
  resident_restored
  resident_access_disabled
  resident_access_enabled
  user_created
  user_sessions_revoked
  message_replied
  message_thread_closed
  message_thread_reopened
  complaint_replied
  complaint_status_changed
  invoice_created
  invoice_voided
  payment_recorded
  access_code_revoked
  access_code_extended
  verification_recorded
  facility_created
  facility_updated
  facility_archived
  booking_confirmed
  booking_cancelled
  booking_completed
  sos_acknowledged
  sos_resolved
  settings_updated
  audit_exported
}
